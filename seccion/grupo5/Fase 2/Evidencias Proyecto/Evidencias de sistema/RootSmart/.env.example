# Variables para docker compose. Copiar como .env (no subir .env a git).

# Clave de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Clave del usuario sa de SQL Server. Mínimo 8 caracteres con mayúsculas,
# minúsculas, números y símbolos, o SQL Server no inicia.
MSSQL_SA_PASSWORD=Cambiar.Esta.Clave1

# Firma de los tokens de sesión. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Opcional
CLAUDE_MODEL=claude-haiku-5-5
