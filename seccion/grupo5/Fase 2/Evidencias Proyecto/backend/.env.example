# Copiar como .env (no subir .env a git)
ANTHROPIC_API_KEY=sk-ant-...

# SQL Server (DB_BI_RUTA_SMART)
DB_SERVER=localhost\MSSQLSERVER01
DB_NAME=DB_BI_RUTA_SMART
DB_DRIVER=ODBC Driver 18 for SQL Server
# Vacíos = autenticación de Windows
DB_USER=
DB_PASSWORD=
# Usuario de BD con solo SELECT sobre ods/dim (db/sqlserver/16_CREATE_USUARIO_LECTOR.sql)
DB_USUARIO_LECTOR=bi_lector
# Segundos para conectar. En Azure SQL usar 60: la base puede estar pausada.
DB_TIMEOUT=5

# Firma de los tokens de sesión. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Correo para recuperar contraseñas (el puerto 587 usa STARTTLS).
# Sin SMTP_HOST el enlace se muestra en la consola del backend: solo para desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional
ORGANIZACION=Ruta Smart
CLAUDE_MODEL=claude-haiku-5-5
FRONTEND_ORIGIN=http://localhost:5173
