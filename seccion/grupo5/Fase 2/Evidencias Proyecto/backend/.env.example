# Copiar como .env (no subir .env a git)
ANTHROPIC_API_KEY=sk-ant-...

# SQL Server (DB_BI_RUTA_SMART)
DB_SERVER=localhost\MSSQLSERVER01
DB_NAME=DB_BI_RUTA_SMART
DB_DRIVER=ODBC Driver 18 for SQL Server
# Vacíos = autenticación de Windows
DB_USER=
DB_PASSWORD=
# Usuario de BD con solo SELECT sobre ods/dim (db/sqlserver/16_CREATE_USUARIO_LECTOR.sql)
DB_USUARIO_LECTOR=bi_lector

# Firma de los tokens de sesión. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Opcional
CLAUDE_MODEL=claude-haiku-5-5
FRONTEND_ORIGIN=http://localhost:5173
